[global]
    monitor = HDMI-1-0
    font = Monospace 21
    offset = 10x10
    origin = top-right

    frame_width = 2
    frame_color = "#555555"

    background = "#222222"
    foreground = "#ffffff"

    padding = 10
    horizontal_padding = 10
    separator_height = 2

    timeout = 5
    history_length = 20

[urgency_low]
    background = "#222222"
    foreground = "#aaaaaa"
    timeout = 3

[urgency_normal]
    background = "#222222"
    foreground = "#ffffff"
    timeout = 5

[urgency_critical]
    background = "#800000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0
